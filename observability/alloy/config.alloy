discovery.docker "order_api" {
  host = "unix:///var/run/docker.sock"

  filter {
    name   = "label"
    values = [
      "com.docker.compose.project=" + sys.env("DOCKER_COMPOSE_PROJECT"),
    ]
  }

  filter {
    name   = "label"
    values = ["com.docker.compose.service=api"]
  }
}

loki.source.docker "order_api" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.docker.order_api.targets
  labels     = { job = "order-api" }
  forward_to = [loki.process.order_api.receiver]
}

loki.process "order_api" {
  stage.json {
    expressions = {
      timestamp     = "timestamp",
      level         = "level",
      message       = "message",
      requestId     = "requestId",
      eventId       = "eventId",
      orderId       = "orderId",
      generation    = "generation",
      processingRun = "processingRun",
      eventType     = "eventType",
    }
  }

  stage.timestamp {
    source = "timestamp"
    format = "RFC3339Nano"
  }

  stage.labels {
    values = {
      level     = "level",
      eventType = "eventType",
    }
  }

  stage.structured_metadata {
    values = {
      requestId     = "requestId",
      eventId       = "eventId",
      orderId       = "orderId",
      generation    = "generation",
      processingRun = "processingRun",
    }
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

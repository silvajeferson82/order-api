NODE_ENV=development
PORT=3000
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_NAME=order_db
RABBITMQ_ENABLED=false
RABBITMQ_URL=amqp://localhost:5672
# Apenas para desenvolvimento local. NODE_ENV=production rejeita AUTH_ENABLED=false.
AUTH_ENABLED=false
# Quando AUTH_ENABLED=true, configure:
# KEYCLOAK_ISSUER=https://keycloak.example/realms/orders
# KEYCLOAK_AUDIENCE=order-api
# KEYCLOAK_JWKS_URI=https://keycloak.example/realms/orders/protocol/openid-connect/certs
# JWKS_CACHE_TTL_MS=600000
# JWKS_TIMEOUT_MS=3000
# JWKS_RATE_LIMIT=10

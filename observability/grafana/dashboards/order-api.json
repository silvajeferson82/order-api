{
  "uid": "order-api-operations",
  "title": "Order API - Operações",
  "tags": ["orders", "operations"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "title": "Taxa HTTP por status",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (status_code) (rate(http_requests_total[5m]))",
          "legendFormat": "{{status_code}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Latência HTTP p95",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Outbox pendente / idade (segundos)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "order_outbox_pending", "legendFormat": "pendentes" },
        {
          "expr": "order_outbox_oldest_pending_age_seconds",
          "legendFormat": "idade"
        }
      ]
    },
    {
      "id": 4,
      "title": "Resultados de processamento",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum by (status) (rate(order_processing_results_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Mensagens prontas e não confirmadas",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "rabbitmq_detailed_queue_messages_ready",
          "legendFormat": "{{queue}} ready"
        },
        {
          "expr": "rabbitmq_detailed_queue_messages_unacked",
          "legendFormat": "{{queue}} unacked"
        }
      ]
    }
  ]
}
